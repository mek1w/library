<Window x:Class="library.RegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:library"
        mc:Ignorable="d"
        Title="Регистрация читателя" Height="650" Width="450" WindowStartupLocation="CenterOwner">
    <Grid Margin="30">
        <ScrollViewer>
            <StackPanel>
                <TextBlock Text="Регистрация" FontSize="28" FontWeight="Bold" 
                           HorizontalAlignment="Center" Margin="0,0,0,20"/>

                <Label Content="ФИО"/>
                <TextBox Name="FullNameBox" Padding="5" Margin="0,0,0,10"/>

                <Label Content="Дата рождения"/>
                <DatePicker Name="BirthDatePicker" Margin="0,0,0,10"/>

                <Label Content="Телефон"/>
                <TextBox Name="PhoneBox" Padding="5" Margin="0,0,0,10"/>

                <Label Content="Email"/>
                <TextBox Name="EmailBox" Padding="5" Margin="0,0,0,10"/>

                <Label Content="Пароль"/>
                <PasswordBox Name="PasswordBox" Padding="5" Margin="0,0,0,10"/>

                <Label Content="Повтор пароля"/>
                <PasswordBox Name="ConfirmPasswordBox" Padding="5" Margin="0,0,0,20"/>

                <Button Content="Зарегистрироваться" Click="Register_Click" 
                        Height="40" Margin="0,0,0,10" FontSize="16"/>

                <Button Content="Отмена" Click="Cancel_Click" 
                        Height="40" FontSize="16"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>