<Window x:Class="library.EditReaderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Читатель" Height="550" Width="400" WindowStartupLocation="CenterScreen"
        Background="LightGray">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Name="HeaderText" Text="Читатель" FontSize="24" FontWeight="Bold" 
                   Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,20">
            <TextBlock.Effect>
                <DropShadowEffect Color="Black" BlurRadius="3" ShadowDepth="3"/>
            </TextBlock.Effect>
        </TextBlock>

        <StackPanel Background="Pink" Grid.Row="1">
            <Label Content="ФИО"  FontWeight="Bold"/>
            <TextBox Name="FullNameBox" Padding="5" Margin="0,0,0,10"/>

            <Label Content="Дата рождения" FontWeight="Bold"/>
            <DatePicker Name="BirthDatePicker" Margin="0,0,0,10"/>

            <Label Content="Телефон" FontWeight="Bold"/>
            <TextBox Name="PhoneBox" Padding="5" Margin="0,0,0,10"/>

            <Label Content="Email" FontWeight="Bold"/>
            <TextBox Name="EmailBox" Padding="5" Margin="0,0,0,10"/>

            <Label Content="Пароль"  FontWeight="Bold"/>
            <PasswordBox Name="PasswordBox" Padding="5" Margin="0,0,0,20"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Background="LightBlue" Content="Сохранить" Click="Save_Click" Padding="20,5" Margin="0,0,10,0"/>
                <Button Background="LightBlue" Content="Отмена" Click="Cancel_Click" Padding="20,5"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>