<Window x:Class="library.EditAuthorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Автор" Height="350" Width="400" WindowStartupLocation="CenterScreen"
        Background="Pink">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Name="HeaderText" Text="Автор" FontSize="24" FontWeight="Bold" 
                   Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,20">
            <TextBlock.Effect>
                <DropShadowEffect Color="Black" BlurRadius="3" ShadowDepth="3"/>
            </TextBlock.Effect>
        </TextBlock>

        <StackPanel Grid.Row="1">
            <Label Content="Имя автора" Foreground="White" FontWeight="Bold"/>
            <TextBox Name="NameBox" Padding="5" Margin="0,0,0,10"/>

            <Label Content="Дата рождения" Foreground="White" FontWeight="Bold"/>
            <DatePicker Name="BirthDatePicker" Margin="0,0,0,20"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Background="LightBlue" Content="Сохранить" Click="Save_Click" Padding="20,5" Margin="0,0,10,0"/>
                <Button Background="LightBlue" Content="Отмена" Click="Cancel_Click" Padding="20,5"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>