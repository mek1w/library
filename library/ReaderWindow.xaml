<Window x:Class="library.ReaderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:library"
        mc:Ignorable="d"
        Title="Личный кабинет читателя" Height="600" Width="900" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <Border Background="Pink" Padding="15" Grid.Column="0">
            <StackPanel>
                <TextBlock Text="Кабинет читателя" FontSize="20" FontWeight="Bold" Margin="0,0,0,20" TextWrapping="Wrap"/>

                <TextBlock Name="WelcomeText" Text="Добро пожаловать!" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,20" TextWrapping="Wrap"/>

                <Button Content="Каталог книг" Click="ShowCatalog_Click" Padding="10" Margin="0,0,0,10"/>
                <Button Name="MyBooksButton" Content="Мои книги" Click="ShowMyBooks_Click" Padding="10" Margin="0,0,0,20" Width="170"/>

                <Button Content="Выйти" Click="Logout_Click" Padding="10" Background="LightCoral"/>
            </StackPanel>
        </Border>

        <Frame Grid.Column="1" Name="ReaderFrame" NavigationUIVisibility="Hidden" Margin="10"/>
    </Grid>
</Window>