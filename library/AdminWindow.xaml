<Window x:Class="library.AdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Панель администратора" Height="700" Width="1150" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <Border Background="Pink" Padding="15" Grid.Column="0">
            <StackPanel>
                <TextBlock Text="Админ-панель" FontSize="20" FontWeight="Bold" Margin="0,0,0,20"/>

                <Button Content="Книги" Click="ShowBooks_Click" Padding="10" Margin="0,0,0,10"/>
                <Button Content="Авторы" Click="ShowAuthors_Click" Padding="10" Margin="0,0,0,10"/>
                <Button Content="Выдача книг" Click="ShowBorrowed_Click" Padding="10" Margin="0,0,0,10"/>
                <Button Content="Читатели" Click="ShowReaders_Click" Padding="10" Margin="0,0,0,20"/>

                <Button Content="Выйти" Click="Logout_Click" Padding="10" Background="LightCoral"/>
            </StackPanel>
        </Border>

        <Frame Grid.Column="1" Name="AdminFrame" NavigationUIVisibility="Hidden" Margin="10"/>
    </Grid>
</Window>