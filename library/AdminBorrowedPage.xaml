<Page x:Class="library.AdminBorrowedPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Выдача книг">
    <Grid Background="LightGray" Margin="5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="Pink" Margin="0,0,0,15">
            <TextBlock Text="Выдача книг" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,10">
                <TextBlock.Effect>
                    <DropShadowEffect Color="White" BlurRadius="2" ShadowDepth="0"/>
                </TextBlock.Effect>
            </TextBlock>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <DataGrid Grid.Column="0" Name="BorrowedGrid" 
                      AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" Margin="0,0,10,0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Книга" Binding="{Binding Book.Title}" Width="*"/>
                    <DataGridTextColumn Header="Читатель" Binding="{Binding Reader.FullName}" Width="200"/>
                    <DataGridTextColumn Header="Дата выдачи" Binding="{Binding BorrowDate, StringFormat=\{0:dd.MM.yyyy\}}" Width="120"/>
                    <DataGridTextColumn Header="Дата возврата" Binding="{Binding ReturnDate, StringFormat=\{0:dd.MM.yyyy\}}" Width="120"/>
                </DataGrid.Columns>
            </DataGrid>

            <StackPanel Grid.Column="1" VerticalAlignment="Top" Margin="10">
                <Button Background="LightBlue" Content="Выдать книгу" Click="IssueBook_Click" Padding="10,5" Margin="0,0,0,10" Width="170"/>
                <Button Background="LightBlue" Content="Вернуть книгу" Click="ReturnBook_Click" Padding="10,5" Width="170"/>
            </StackPanel>
        </Grid>
    </Grid>
</Page>